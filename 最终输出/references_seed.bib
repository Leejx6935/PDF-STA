
@article{ding_prescribed-time_2026,
	title = {Prescribed-{Time} {Control} via {Periodic} {Delayed} {Feedback}-{Based} {Super}-{Twisting} {Sliding} {Mode} {Algorithm}},
	volume = {71},
	copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
	issn = {0018-9286, 1558-2523, 2334-3303},
	url = {https://ieeexplore.ieee.org/document/11195188/},
	doi = {10.1109/TAC.2025.3618707},
	abstract = {This article investigates the problem of prescribed-time control via continuous sliding mode control laws. First, within the framework of the periodic delayed feedback approach, two novel super-twisting algorithms are proposed, whose settling times are bounded by a constant independent of the initial conditions and can be arbitrarily prescribed. Next, for a class of high-order uncertain nonlinear systems, a novel disturbance observer and a prescribed-time continuous sliding mode control law are designed based on the ﬁrst super-twisting algorithm. Furthermore, for a class of perturbed double integrator systems, a novel state observer and a prescribed-time continuous sliding mode control law by output feedback are designed based on the second super-twisting algorithm. Unlike the widely used time-varying high-gain feedback approach in the literature, the control laws designed in this article ensure that the system output converges to zero with the settling time being exactly equal to the prescribed time, even in the presence of both matched and mismatched disturbances, while mitigating sensitivity to measurement noise and avoiding the singularity issues caused by inﬁnite gain. Finally, the effectiveness of the proposed approaches is demonstrated through simulations.},
	language = {en},
	number = {3},
	urldate = {2026-10-11},
	journal = {IEEE Transactions on Automatic Control},
	author = {Ding, Yi and Zhou, Bin and Shi, Yang},
	month = mar,
	year = {2026},
	pages = {1813--1828},
	annote = {



引言“This article investigates the problem of prescribed-time control via continuous sliding mode control laws. First, within the framework of the periodic delayed feedback approach, two novel super-twisting algorithms are proposed, whose settling times are bounded by a constant independent of the initial conditions and can be arbitrarily prescribed. Next, for a class of high-order uncertain nonlinear systems, a novel disturbance observer and a prescribed-time continuous sliding mode control law are designed based on the first super-twisting algorithm. Furthermore, for a class of perturbed double integrator systems, a novel state observer and a prescribed-time continuous sliding mode control law by output feedback are designed based on the second super-twisting algorithm. Unlike the widely used time-varying high-gain feedback approach in the literature, the control laws designed in this article ensure that the system output converges to zero with the settling time being exactly equal to the prescribed time, even in the presence of both matched and mismatched disturbances, while mitigating sensitivity to measurement noise and avoiding the singularity issues caused by infinite gain. Finally, the effectiveness of the proposed approaches is demonstrated through simulations.” (Ding 等, 2026, p. 1813)


本文解决的问题传统STA的调节时间不能任意小，通过线性项改善的STA不可能将调节时间改变到任意值，且调节时间与初值有关。通过提出基于PDF时滞框架的STA算法是调节时间与初值无关，基于上面的STA构造的干扰观测器可以实现观测误差在任意时间趋近到0.
如何实现上述的优势





},
	file = {PDF:C\:\\Users\\leejx\\Zotero\\storage\\MKEKXJK7\\Ding 等 - 2026 - Prescribed-Time Control via Periodic Delayed Feedback-Based Super-Twisting Sliding Mode Algorithm.pdf:application/pdf},
