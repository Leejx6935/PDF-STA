	author = {Peng, Jiguang and Liu, Zhi and Chen, C. L. Philip and Zhang, Yun},
	month = aug,
	year = {2025},
	keywords = {Actuator attacks, Command filter, Nonlinear multi-agent systems (MASs), Predefined-time, State observer},
	pages = {107855},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\leejx\\Zotero\\storage\\8WRRX3X2\\Peng 等 - 2025 - Command filter-based adaptive predefined-time control for nonlinear multi-agent systems under unknow.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\leejx\\Zotero\\storage\\KDZEUNK5\\S0016003225003485.html:text/html},
}

@article{zhang_adaptive_2024,
	title = {Adaptive practical prescribed-time control for uncertain nonlinear systems with time-varying parameters},
	volume = {189},
