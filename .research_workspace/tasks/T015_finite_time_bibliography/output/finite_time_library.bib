@inproceedings{sanchez-torres_predefined-time_2015,
	title = {Predefined-time stability of dynamical systems with sliding modes},
	issn = {2378-5861},
	url = {https://ieeexplore.ieee.org/document/7172255},
	doi = {10.1109/ACC.2015.7172255},
	abstract = {This paper introduces a class of fixed-time stable dynamical systems with settling time as a explicit parameter, namely the inverse the gain. Those systems are defined as predefined-timed stable dynamical systems. Continuous and discontinuous are cases are presented. A detailed Lyapunov characterization of this class of systems is also shown. Finally, the application to the design of a class of first order sliding mode controllers is exposed.},
	urldate = {2026-10-17},
	booktitle = {2015 {American} {Control} {Conference} ({ACC})},
	author = {Sánchez-Torres, Juan Diego and Sanchez, Edgar N. and Loukianov, Alexander G.},
	month = jul,
	year = {2015},
	note = {ISSN: 2378-5861},
	keywords = {Lyapunov methods, Robustness, Trajectory, Sliding mode control, Stability analysis, Optimization},
	pages = {5842--5846},
	annote = {本文基于滑模控制的思想提出了预定义时间控制模型，选取的选型思路是\$\{{\textbackslash}dot\{x\}\} = {\textbackslash}alpha e{\textasciicircum}\{-x\}\$，可以实现预设时间收敛的性质（分强定义与弱定义），强定义收敛时间精确，弱定义收敛时间小于上界。
\$\${\textbackslash}boldsymbol\{{\textbackslash}dot\{x\}\} = -{\textbackslash}frac\{1\}\{T\_c\}{\textbackslash}boldsymbol\{{\textbackslash}Phi\}\_p(x)\$\$
上式为Predefined time control标准形式，其中
\$\${\textbackslash}boldsymbol\{{\textbackslash}Phi\}\_p(x) = {\textbackslash}frac\{1\}\{p\}{\textbackslash}frac\{{\textbackslash}exp{\textbackslash}left({\textbackslash}{\textbar}x{\textbackslash}{\textbar}{\textasciicircum}p{\textbackslash}right)x\}\{{\textbackslash}{\textbar}x{\textbackslash}{\textbar}{\textasciicircum}p\}\$\$
通过运用
\$\${\textbackslash}boldsymbol\{{\textbackslash}dot\{x\}\} = {\textbackslash}dot\{{\textbar}x{\textbar}\} sgn(x)\$\$
可以对其进行求导， \${\textbackslash}boldsymbol\{{\textbar}x{\textbar}\}\$ 起到类似李雅普诺夫函数的作用
可以得到收敛时间t满足
\$\${\textbackslash}boldsymbol\{t\} {\textgreater} t\_\{0\} + T\_c\$\$
当然，以上推导是建立在系统扰动为0或者扰动对系统的影响可以忽略的时候，现在考虑扰动项对系统的影响
针对以下系统
\$\${\textbackslash}boldsymbol\{{\textbackslash}dot\{x\}\} = {\textbackslash}boldsymbol\{{\textbackslash}Delta\}(t, x) + {\textbackslash}boldsymbol\{u\}\$\$
where \${\textbackslash}boldsymbol\{x\}, {\textbackslash}boldsymbol\{u\} {\textbackslash}in {\textbackslash}mathbb\{R\}{\textasciicircum}n\$, \${\textbackslash}boldsymbol\{{\textbackslash}Delta\}: {\textbackslash}mathbb\{R\}\_+ {\textbackslash}times {\textbackslash}mathbb\{R\}{\textasciicircum}n {\textbackslash}to {\textbackslash}mathbb\{R\}{\textasciicircum}n\$ and \$t\_0 = 0\$.
当出现扰动的情况时，穾设定另外的控制输入项来抑制扰动。
\$\${\textbackslash}boldsymbol\{u\} = -{\textbackslash}left({\textbackslash}frac\{1\}\{T\_c\} + kp{\textbackslash}right){\textbackslash}boldsymbol\{{\textbackslash}Phi\}\_p(x)\$\$
where \$k\_p\$ 线性增益反馈项是为了处理扰动的，其中\$k\_p\$满足\$k {\textgreater}= {\textbackslash}delta ,0 {\textless}p{\textless}1\$ 。取李雅普诺夫函数为  \${\textbar}{\textbar}x{\textbar}{\textbar}\$ 并对其求导可证明预定义时间收敛。
\$\${\textbackslash}boldsymbol\{u\} = -{\textbackslash}left({\textbackslash}frac\{1\}\{T\_c\} + k{\textbackslash}right){\textbackslash}boldsymbol\{{\textbackslash}Phi\}\_1(x)\$\$
同理也可得出同样的结论。基于以上的分析，对于论文的拓展部分也可以自行实现了。
},
	file = {Full Text PDF:C\:\\Users\\leejx\\Zotero\\storage\\UR2SF69G\\Sánchez-Torres 等 - 2015 - Predefined-time stability of dynamical systems with sliding modes.pdf:application/pdf},
}

@article{yang_output_2021,
