@article{gonzalez_variable_2012,
	title = {Variable {Gain} {Super}-{Twisting} {Sliding} {Mode} {Control}},
	volume = {57},
	issn = {1558-2523},
	url = {https://ieeexplore.ieee.org/document/6104366/},
	doi = {10.1109/TAC.2011.2179878},
	abstract = {In this note, a novel, Lyapunov-based, variable-gain super-twisting algorithm (STA) is proposed. It ensures for linear time invariant systems the global, finite-time convergence to the desired sliding surface, when the matched perturbations/uncertainties are Lipschitz-continuous functions of time, that are bounded, together with their derivatives, by known functions. The proposed algorithm has similar properties to the variable-gain first-order sliding mode control, but it provides alleviation to the chattering phenomenon. The results are verified experimentally.},
	number = {8},
	urldate = {2026-10-13},
	journal = {IEEE Transactions on Automatic Control},
	author = {Gonzalez, Tenoch and Moreno, Jaime A. and Fridman, Leonid},
	month = aug,
	year = {2012},
	keywords = {Convergence, Lyapunov functions, Lyapunov methods, Robustness, Chattering effect, Differential equations, discontinuous systems, Gain, robust control, second-order sliding modes, Sliding mode control, Uncertainty},
	pages = {2100--2105},
	annote = {时变STA滑膜控制
引言
“Abstract—In this note, a novel, Lyapunov-based, variable-gain super-twisting algorithm (STA) is proposed. It ensures for linear time invariant systems the global, finite-time convergence to the desired sliding surface, when the matched perturbations/uncertainties are Lipschitz-continuous functions of time, that are bounded, together with their derivatives, by known functions. The proposed algorithm has similar properties to the variable-gain first-order sliding mode control, but it provides alleviation to the chattering phenomenon. The results are verified experimentally.” (Gonzalez 等, 2012, p. 2100)
本文的贡献
提出了一种改进的STA算法，可以进一步降低扰动对系统的干扰，，系统控制形式
The VGSTA proposed here is given by
\$\${\textbackslash}dot\{{\textbackslash}eta\} = (A\_\{11\} + A\_\{12\}K){\textbackslash}eta + A\_\{12\}s,\$\$
\$\${\textbackslash}dot\{s\} = v + {\textbackslash}tilde\{f\}({\textbackslash}eta, s + K{\textbackslash}eta, t).\$\$
\$\$v = -k\_1(t,x){\textbackslash}phi\_1(s) - {\textbackslash}int\_\{0\}{\textasciicircum}\{t\} k\_2(t,x){\textbackslash}phi\_2(s)dt\$\$
where
\$\${\textbackslash}begin\{aligned\}
{\textbackslash}phi\_1(s) \&= {\textbar}s{\textbar}{\textasciicircum}\{1/2\}{\textbackslash}mathrm\{sign\}(s) + k\_3 s,{\textbackslash}quad k\_3 {\textgreater} 0 {\textbackslash}{\textbackslash}
{\textbackslash}phi\_2(s) \&= {\textbackslash}phi\_1'(s){\textbackslash}phi\_1(s) {\textbackslash}{\textbackslash}
\&= {\textbackslash}frac\{1\}\{2\}{\textbackslash}mathrm\{sign\}(s) + {\textbackslash}frac\{3\}\{2\}k\_3 {\textbar}s{\textbar}{\textasciicircum}\{1/2\}{\textbackslash}mathrm\{sign\}(s) + k\_3{\textasciicircum}2 s.
{\textbackslash}end\{aligned\}\$\$
criterion \${\textbackslash}dot\{V\}({\textbackslash}eta) {\textbackslash}leq -{\textbackslash}sigma\_1 V{\textasciicircum}\{1/2\}({\textbackslash}eta) - {\textbackslash}sigma\_2 V({\textbackslash}eta).\$ The corresponding settling time can be estimated as
\$\$T(x\_0) = {\textbackslash}frac\{2\}\{{\textbackslash}sigma\_2\}{\textbackslash}ln{\textbackslash}left( {\textbackslash}frac\{{\textbackslash}sigma\_2\}\{{\textbackslash}sigma\_1\} V{\textasciicircum}\{1/2\}({\textbackslash}eta(0)) + 1 {\textbackslash}right). \$\$
实现了对收敛时间的估计，可以发现，收敛时间相比传统STA可以达到收敛时间任意小，但是还是与初值有关。在新的研究中已经解决此类问题。
在本文中需要重点掌握其稳定性证明方法，通过构造PD矩阵（文中为P）定义李雅普诺夫函数，对其求导得到\${\textbackslash} -Q = A{\textasciicircum}T P + PA\$ ,于是证明采用二次型的性质可以利用特征值证明渐进稳定。
},
	file = {Full Text PDF:C\:\\Users\\leejx\\Zotero\\storage\\ASXD8F6H\\Gonzalez 等 - 2012 - Variable Gain Super-Twisting Sliding Mode Control.pdf:application/pdf},
}

@article{chen_practical_2025,
	title = {Practical {Finite}-{Time} {Observer}-{Based} {Adaptive} {Backstepping} {Super}-{Twisting} {Sliding} {Mode} {Control} for {Deep}-{Sea} {Hydraulic} {Manipulator}},
	volume = {72},
	issn = {1557-9948},
	url = {https://ieeexplore.ieee.org/document/10904031},
	doi = {10.1109/TIE.2025.3541284},
	abstract = {Parameter uncertainties and unknown disturbances always exist in the trajectory tracking control of a deep-sea hydraulic manipulators (DHMs), significantly reducing tracking accuracy. To address these issues, a practical finite-time observer-based adaptive backstepping super-twisting sliding mode control method (PFTO-ABSTC) is proposed for precise DHM tracking control. First, a projection-type adaptive law is constructed to handle the parameter uncertainties. In addition, Levant’s Differentiator is employed to obtain velocity of the DHM and construct the adaptive law regression vector, minimizing system noise from differentiation and filtering operations. Second, a practical finite-time observer (PFTO) strategy is proposed to estimates lump disturbances and compensates them in the controller, avoiding high-gain phenomenon of the controller effectively. Then, the PFTO-ABSTC controller is proposed by integrating the backstepping technique, which chattering-free property can be achieved. In addition, the uncertainties and disturbances of the DHM dynamics are well addressed in the closed-loop system, and asymptotic tracking performance can be guaranteed by Lyapunov theory. Finally, comparative experimental results validate the effectiveness of the proposed control strategy. Experimental results show that the proposed method can achieve smaller control errors and better control performance than the ESO-ABSTC, ABSTC, and PID control methods, and the maximum control errors are improved by at least 41.30\%, 50.76\%, and 66.67\%, respectively.},
	number = {9},
	urldate = {2026-10-13},
	journal = {IEEE Transactions on Industrial Electronics},
	author = {Chen, Gang and Wu, Wei and Yang, Chenguang and Hu, Huosheng and Zhang, Jingjing and Shi, Jianwei and Wu, Chuanyu and Ma, Yu},
	month = sep,
	year = {2025},
	keywords = {Observers, Symmetric matrices, Sliding mode control, Uncertainty, Backstepping technique, deep-sea hydraulic manipulator (DHM), Electronic mail, finite-time observer, Manipulator dynamics, Mechanical engineering, Motion control, nonlinear systems, Servomotors, sliding mode control},
	pages = {9569--9579},
	file = {Full Text PDF:C\:\\Users\\leejx\\Zotero\\storage\\84EGL6QC\\Chen 等 - 2025 - Practical Finite-Time Observer-Based Adaptive Backstepping Super-Twisting Sliding Mode Control for D.pdf:application/pdf},
}

@article{wang_modified_2026,
	title = {A {Modified} {Super}-{Twisting} {Sliding} {Mode} {Control} for {Aircraft} {Braking} {System} {With} {Adaptive} {Gain} {Schedule} and {Disturbance} {Compensation}},
	volume = {73},
	issn = {1557-9948},
	url = {https://ieeexplore.ieee.org/document/11230881},
	doi = {10.1109/TIE.2025.3613654},
	abstract = {To overcome the adverse effects of time-varying parametric uncertainties and strong disturbances in aircraft antiskid braking systems (ABS), achieving efficient antiskid braking control and shortening the braking distance. This article proposes a modified super-twisting sliding mode control (MSSMC)-based aircraft ABS controller with gain adaptive schedule and disturbance compensation. In this article, MSSMC is obtained by substituting the discontinuous term in the conventional super-twisting sliding mode control (SSMC) with a continuous fractional power term, which can alleviate the chattering and improve the tracking performance. The developed controller is derived by effectively integrating MSSMC, extended state observer (ESO) and gain adaptive techniques, preserving the advantages of these approaches while effectively overcoming their practical performance limitations. The time-varying disturbances and unmodeled dynamics in aircraft ABS are estimated by ESO and compensated in a feedforward way, which significantly decreases the residual uncertainties handled by the MSSMC, thus alleviating the burden on the MSSMC and avoiding the high-gain feedback. In addition, a novel gain adaptive protocol for MSSMC is proposed, which can minimize the control gain and the chattering amplitude without the prerequisite of uncertain upper boundary required for conventional SSMC. Theoretical analysis based on the Lyapunov approach shows that the designed ABS controller ensures that the sliding variable converges to the desired accuracy near the origin in a finite time. Comparative experimental results demonstrate the effectiveness of the proposed approach.},
	number = {3},
	urldate = {2026-10-13},
	journal = {IEEE Transactions on Industrial Electronics},
	author = {Wang, Zhuangzhuang and Liu, Xiaochao and Sun, Xuefeng and Qi, Pengyuan and Wu, Shuai},
	month = mar,
	year = {2026},
	keywords = {Uncertainty, Friction, Aerodynamics, Aerospace control, Aircraft, Aircraft antiskid braking system, Atmospheric modeling, Brakes, extended state observer, gain adaptive, Lead, modified super-twisting sliding mode control, slip ratio, Torque, Wheels},
	pages = {4308--4318},
	file = {Full Text PDF:C\:\\Users\\leejx\\Zotero\\storage\\YGZ52Z2K\\Wang 等 - 2026 - A Modified Super-Twisting Sliding Mode Control for Aircraft Braking System With Adaptive Gain Schedu.pdf:application/pdf},
}

@article{ding_strong_2024,
	title = {Strong {Prescribed}-{Time} {Stabilization} of {Uncertain} {Nonlinear} {Systems} by {Periodic} {Delayed} {Feedback}},
	volume = {69},
	issn = {1558-2523},
	url = {https://ieeexplore.ieee.org/document/10375772},
	doi = {10.1109/TAC.2023.3347703},
	abstract = {In this article, a novel Lyapunov-based approach for strong prescribed-time stabilization by periodic delayed feedback is established. Since the comparison lemma cannot be directly applied to time-delay systems, their proofs rely on trajectory analysis. Based on this approach, a novel control law for strong prescribed-time stabilization of uncertain scalar nonlinear systems is obtained, with the following appealing properties: singularity problems inherent to time-varying high gain approaches are avoided; strong prescribed-time stabilization is achieved with control terms exhibiting a linear growth rate in the combined current and delayed state variable; the achieved fixed-time stability is preserved under classes of additive perturbations; and the setting time of the closed-loop system equals the prescribed value for some admissible uncertainties. Subsequently, using the backstepping procedure, a strongly prescribed-time stabilizing control law for strict feedback uncertain nonlinear systems is designed. Numerical simulations are shown to verify the effectiveness of the proposed approaches.},
	number = {6},
	urldate = {2026-10-15},
	journal = {IEEE Transactions on Automatic Control},
	author = {Ding, Yi and Zhou, Bin and Zhang, Kang-Kang and Michiels, Wim},
	month = jun,
	year = {2024},
	keywords = {Lyapunov methods, Uncertainty, Asymptotic stability, Delay effects, High-order nonlinear systems, Nonlinear systems, Numerical stability, periodic delayed feedback (PDF), prescribed-time stabilization, Stability criteria, strong prescribed-time stabilization},
	pages = {4072--4079},
	file = {Full Text PDF:C\:\\Users\\leejx\\Zotero\\storage\\ZZGIMXB3\\Ding 等 - 2024 - Strong Prescribed-Time Stabilization of Uncertain Nonlinear Systems by Periodic Delayed Feedback.pdf:application/pdf},
}

